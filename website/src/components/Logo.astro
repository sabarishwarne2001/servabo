---
/** The Servabo logo: the mark (ribbon S, orbit ring, glowing dot) and the wordmark, from brand/mark.ts. */
import { DOT, ORBIT, RIBBON_STOPS, S_STROKE, S_WIDTH, TILE, TILE_COLOURS, WORDMARK } from "../../../brand/mark";

interface Props {
  class?: string;
  /** Mark only (16 px and up). */
  markOnly?: boolean;
}
const { class: className = "", markOnly = false } = Astro.props;
const scale = 15.6 / WORDMARK.capHeight;
// 1.5 units of room for the leaf, which overhangs the last letter.
const width = markOnly ? 32 : 32 + 9 + WORDMARK.width * scale + 1.5;
// One gradient set per drawing: a copy that is hidden (a mobile menu, say) must not take the paint with it.
const uid = `sv${Math.random().toString(36).slice(2, 8)}`;
---
<svg
  viewBox={`0 0 ${width.toFixed(2)} 32`}
  class={className}
  role="img"
  aria-label="Servabo"
  focusable="false"
>
  <defs>
    <linearGradient id={`${uid}-r`} gradientUnits="userSpaceOnUse" x1="11" y1="8" x2="22" y2="26">
      {RIBBON_STOPS.map(([offset, colour]) => <stop offset={offset} stop-color={colour} />)}
    </linearGradient>
    <linearGradient id={`${uid}-o`} gradientUnits="userSpaceOnUse" x1="2" y1="22" x2="30" y2="10">
      <stop offset="0" stop-color="#8b5cf6" stop-opacity="0.15" />
      <stop offset="0.55" stop-color="#3b82f6" />
      <stop offset="1" stop-color="#2ee6f2" />
    </linearGradient>
    <linearGradient id={`${uid}-t`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color={TILE_COLOURS[0]} />
      <stop offset="1" stop-color={TILE_COLOURS[1]} />
    </linearGradient>
    <radialGradient id={`${uid}-g`}>
      <stop offset="0" stop-color="#7df3ff" stop-opacity="0.95" />
      <stop offset="1" stop-color="#2ee6f2" stop-opacity="0" />
    </radialGradient>
  </defs>
  <path d={TILE} fill={`url(#${uid}-t)`} />
  <ellipse cx={ORBIT.cx} cy={ORBIT.cy} rx={ORBIT.rx} ry={ORBIT.ry} transform={`rotate(${ORBIT.rot} ${ORBIT.cx} ${ORBIT.cy})`} fill="none" stroke={`url(#${uid}-o)`} stroke-width={ORBIT.width} />
  <path d={S_STROKE} fill="none" stroke={`url(#${uid}-r)`} stroke-width={S_WIDTH} stroke-linecap="round" stroke-linejoin="round" />
  <path d={S_STROKE} fill="none" stroke="#fff" stroke-opacity="0.38" stroke-width="0.9" stroke-linecap="round" stroke-linejoin="round" transform="translate(-0.8 -0.9)" />
  <circle cx={DOT.x} cy={DOT.y} r={DOT.r * 2.3} fill={`url(#${uid}-g)`} />
  <circle cx={DOT.x} cy={DOT.y} r={DOT.r} fill="#fff" />
  {!markOnly && (
    <g transform={`translate(41 24.6) scale(${scale.toFixed(6)})`}>
      <path class="fill-foreground" d={WORDMARK.d} />
      <path fill="#2f8cff" d={WORDMARK.leaf} />
    </g>
  )}
</svg>
